# Copy to .env for local (non-docker) runs

APP_NAME=AsyncPaymentProcessor
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# Required in the X-API-Key header on every request.
API_KEY=dev-api-key

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PREFETCH_COUNT=10

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=20

GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
GATEWAY_SUCCESS_RATE=0.9

MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_DELAY_MS=2000

WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
WEBHOOK_CIRCUIT_BREAKER_RESET_SECONDS=30.0
